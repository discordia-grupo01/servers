ENVIRONMENT=development
HOST=0.0.0.0
PORT=8080

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=discordia_servicio
DATABASE_USER=discordia
DATABASE_PASSWORD=discordia
# "disable" en local; "require" cuando la DB es Supabase.
DATABASE_SSLMODE=disable
# Vacio en local (usa el search_path por defecto). En Supabase, el schema
# dedicado del servicio dentro del proyecto compartido, ej: servers
DATABASE_SCHEMA=

# Maximo de conexiones del pool. Vacio o 0 = el default de pgx, max(4, CPUs).
# Subirlo (ej. 10) si las consultas esperan una conexion libre; revisar antes el
# limite de conexiones de la base o del pooler.
DATABASE_MAX_CONNS=

# SOLO desarrollo local: permite pasar el usuario con el header X-User-Id
# (curl/Postman sin JWT). No setear en entornos desplegados: vacio = se usa
# el "sub" del JWT, que es lo seguro detras de Kong.
USER_ID_HEADER=X-User-Id

ICON_DIR=./data/icons
ICON_MAX_BYTES=2097152

SUPABASE_STORAGE_URL=
SUPABASE_STORAGE_BUCKET=
SUPABASE_SERVICE_KEY=

# Vacio en local si no se quiere probar la publicacion de eventos: el
# publisher queda en no-op. Contenedor compartido con discordia-identify,
# ver README.
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Secreto HMAC compartido con discordia-admin: firma los eventos
# admin.user_suspended / admin.user_reactivated y este servicio descarta los que
# no verifican. Obligatorio si RABBITMQ_URL esta seteada (si no, no arranca).
ADMIN_EVENTS_HMAC_SECRET=
